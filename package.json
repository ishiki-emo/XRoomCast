{
  "name": "xroomcast",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "fixtures"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/viewer",
    "build": "npm run build --workspace apps/viewer",
    "bridge": "npm run dev --workspace apps/bridge",
    "sim": "npm run sim --workspace apps/bridge",
    "test": "npm run test --workspace packages/protocol",
    "generate:motion": "npm run generate --workspace fixtures",
    "room": "node apps/viewer/scripts/roomLink.mjs",
    "deploy:viewer": "npm run deploy --workspace apps/viewer"
  },
  "description": "VRMアバターのマルチ環境ライブ配信(PC/スマホ/HMD、AR/MR対応)"
}
