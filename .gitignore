apps/viewer/wrangler.jsonc

# 個人的な検討メモ(事業方針・利用量の見積もり)
ライセンス・配布形態メモ.md
Cloudflare利用量メモ.md

# テスト用VRMはコミットしない(fixtures/README.md 参照)
*.vrm

# 生成物
fixtures/dummy-motion.bin

# VRM配信トークン(wrangler secretに登録済みの控え)
.vrm-token.txt

# セットアップウィザードの控え(発行したキーとURL。秘密を含む)
.setup-keys.json
# ウィザードの一時ファイル(アップロード中のVRM・シークレット登録用)
apps/setup/.tmp/
apps/viewer/.secrets.bulk.tmp.json
# ウィザードが退避した旧設定
.env.bak-*

# 視聴URLのQR(秘密キー入りURLを含む)
qr-watch.png

