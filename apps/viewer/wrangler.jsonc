// Cloudflare Workers(静的アセット+R2配信)でビューアを公開するための設定
// デプロイ: npm run deploy(ビルド → distからVRM除去 → wrangler deploy)
// VRM_TOKEN は `npx wrangler secret put VRM_TOKEN` で設定する(コミットしない)
{
  "name": "vrmsync-viewer",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "VRM_BUCKET",
      "bucket_name": "vrmsync-assets"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SFU_STATE",
      "id": "71a38014ca8746d4a9e6dc60d7fca97e"
    }
  ],
  "vars": {
    "DEFAULT_VRM_KEY": "Emo.vrm"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PRESENCE",
        "class_name": "Presence"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Presence"]
    }
  ]
}
