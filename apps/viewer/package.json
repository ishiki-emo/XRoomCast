{
  "name": "@xroomcast/viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "//dev:worker": "Workerごとローカルで動かす。VRMを除去してから起動しないと、wranglerが25MiB上限で落ちる",
    "dev:worker": "npm run build && node scripts/stripVrmFromDist.mjs && wrangler dev",
    "deploy": "npm run build && tsc --noEmit -p worker && node scripts/stripVrmFromDist.mjs && wrangler deploy"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "@pixiv/three-vrm": "^3.4.0",
    "@types/qrcode-generator": "^0.0.16",
    "@xroomcast/fixtures": "*",
    "@xroomcast/protocol": "*",
    "@xroomcast/sync": "*",
    "@xroomcast/viewer-core": "*",
    "qrcode-generator": "^2.0.4",
    "three": "^0.172.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260714.1",
    "@types/three": "^0.172.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.110.0"
  }
}
