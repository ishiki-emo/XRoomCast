{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // WebSocket / RTCPeerConnection / fetch を使うためDOMの型が要る。
    // ただしDOM要素(document, HTMLElement)は一切触らない
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
