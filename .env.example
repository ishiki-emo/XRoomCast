# Cloudflare Realtime(Calls)の認証情報(Phase 2c)
# ダッシュボード → Realtime → Create App で発行される
# App Secret はブリッジ(Node)だけが読む。ブラウザには絶対に渡さないこと
CF_REALTIME_APP_ID=
CF_REALTIME_APP_SECRET=

# ビューアWorkerへパブリッシャーを登録する場合(トンネル不要化)
VIEWER_ORIGIN=
BRIDGE_TOKEN=

# 配信するルーム(未設定なら main)。視聴URLのルームと一致させる
ROOM=

# ルーム別の視聴/配信トークンを導出するマスターシークレット。
# `npm run room -- <ルーム名>` でURLを生成するために使う。
# Worker側にも同じ値を `npx wrangler secret put ROOM_SECRET` で設定すること
ROOM_SECRET=
